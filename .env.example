# Shared settings for VPS deploy. Copy to .env and fill secrets.

# Telegram bot for sending VPN links/QR after deploy.
# Create bot via @BotFather, get chat id via @userinfobot or by sending a message to the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public IP of this VPS. Auto-detected if empty.
PUBLIC_IP=

# Optional override for the address clients connect to (IP or domain).
# If empty, SERVER_ADDR is taken from PUBLIC_IP.
SERVER_ADDR=

# REALITY camouflage target. github.com is compatible with sing-box clients; Microsoft currently causes EOF.
REALITY_DEST=github.com:443
REALITY_SERVER_NAME=github.com

# Client-side settings used only for generating the VLESS link.
CLIENT_FP=chrome
FLOW=xtls-rprx-vision
